rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions using Custom Claims (set by syncUserClaims function) ──
    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.get('role', 'staff');
    }

    function claimStoreId() {
      return request.auth.token.get('storeId', '');
    }

    function isSuperOwner() {
      return isAuth() && (
        role() == 'super_owner' ||
        request.auth.token.email == 'dumonttexas@gmail.com'
      );
    }

    function isRegionalOwner() {
      return isAuth() && role() == 'regional_owner';
    }

    function isStoreOwnerOrAbove() {
      return isAuth() && (
        role() == 'super_owner' ||
        role() == 'regional_owner' ||
        role() == 'store_owner' ||
        request.auth.token.email == 'dumonttexas@gmail.com'
      );
    }

    function isManagerOrAbove() {
      return isAuth() && (
        role() == 'super_owner' ||
        role() == 'regional_owner' ||
        role() == 'store_owner' ||
        role() == 'manager' ||
        request.auth.token.email == 'dumonttexas@gmail.com'
      );
    }

    function canAccessStore(storeId) {
      return isSuperOwner()
        || isRegionalOwner()
        || claimStoreId() == storeId;
    }

    // ── Users collection ───────────────────────────────────────────────────────
    // User management is super_owner only. The one exception: an invitee may
    // create their OWN doc during onboarding, but only with the exact role/store
    // from a pending, unexpired invitation created by the super_owner.
    function hasValidInvite(data) {
      let inv = get(/databases/$(database)/documents/invitations/$(data.inviteToken)).data;
      return inv.email == request.auth.token.email
        && inv.role == data.role
        && inv.storeId == data.storeId
        && inv.status == 'pending'
        && inv.expiresAt > request.time.toMillis();
    }

    match /users/{emailKey} {
      allow read: if isAuth();
      allow create: if isSuperOwner() || (
        isAuth()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role != 'super_owner'
        && request.resource.data.inviteToken is string
        && hasValidInvite(request.resource.data)
      );
      // Non-super users may only touch harmless fields on their OWN doc
      // (e.g. clearing forcePasswordChange after first login)
      allow update: if isSuperOwner() || (
        isAuth()
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['forcePasswordChange', 'name'])
      );
      allow delete: if isSuperOwner();
    }

    // ── Org / Region / Store metadata ──────────────────────────────────────────
    match /orgs/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    match /regions/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    match /stores/{id} {
      allow read:   if canAccessStore(id);
      allow create, delete: if isSuperOwner();
      // Store owners can edit their OWN store's doc only
      allow update: if isSuperOwner() || (isStoreOwnerOrAbove() && claimStoreId() == id);
    }

    // ── Per-store subcollections ───────────────────────────────────────────────
    // inventory, stockLog, deliveries, checklists, schedule, cashRegister, salesLedger, etc.
    // Only users assigned to that store (or super_owner) can read/write
    match /stores/{storeId}/{subcollection}/{docId} {
      allow read, write: if canAccessStore(storeId);
    }

    // Deep subcollections (e.g. stores/{id}/inventory/stock/items/{itemId})
    match /stores/{storeId}/{subcollection}/{docId}/{rest=**} {
      allow read, write: if canAccessStore(storeId);
    }

    // ── Org items (menu master) ────────────────────────────────────────────────
    match /orgs/{orgId}/items/{itemId} {
      allow read:  if isAuth();
      allow write: if isSuperOwner() || isStoreOwnerOrAbove();
    }

    // ── Global collections ────────────────────────────────────────────────────
    // Schedule — accessible to any authenticated user (same pattern as cashRegister/stockLog)
    match /stores/{storeId}/schedule/{docId} {
      allow read, write: if isAuth();
    }

    match /transfers/{id} {
      allow read, write: if isAuth();
    }

    // Invitations: only super_owner can mint them. An invitee may read theirs
    // and mark it accepted during onboarding — nothing else.
    match /invitations/{id} {
      allow read: if isAuth();
      allow create, delete: if isSuperOwner();
      allow update: if isSuperOwner() || (
        isAuth()
        && resource.data.email == request.auth.token.email
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'acceptedAt'])
      );
    }

    match /announcements/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    // Bulletin: links and issues — super_owner writes, everyone reads
    match /bulletinLinks/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    match /bulletinIssues/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    match /bulletinContacts/{id} {
      allow read:  if isAuth();
      allow write: if isSuperOwner();
    }

    match /signupRequests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isSuperOwner();
    }

    // Audit log — anyone can append, only super_owner reads
    match /auditLog/{id} {
      allow create: if isAuth();
      allow read:   if isSuperOwner();
      allow update, delete: if isSuperOwner();
    }

    // Invoice inbox — written by Cloud Function (admin SDK bypasses rules)
    // Managers+ can read; store_owner+ can update (approve); super_owner can delete
    match /invoices/{id} {
      allow read:             if isManagerOrAbove();
      allow update:           if isStoreOwnerOrAbove();
      allow delete:           if isSuperOwner();
    }

    // Invoice pipeline metadata — Cloud Function only (admin SDK)
    match /_invoiceMeta/{id} {
      allow read, write: if isSuperOwner();
    }
  }
}
